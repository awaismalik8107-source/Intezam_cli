if(NOT DEFINED DESTINATION)
    message(FATAL_ERROR "DESTINATION is required")
endif()
set(media_names front.mp4 tail.mp4 video.mkv video.webm video.mov video.m4v video.avi video.ts)
if(CLEANUP)
    foreach(name IN LISTS media_names)
        file(REMOVE "${DESTINATION}/${name}")
    endforeach()
    return()
endif()
if(NOT DEFINED FFMPEG)
    message(FATAL_ERROR "FFMPEG is required")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
function(encode)
    execute_process(COMMAND "${FFMPEG}" -hide_banner -loglevel error -y ${ARGN}
        RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "FFmpeg media fixture failed: ${diagnostic}")
    endif()
endfunction()
encode(-f lavfi -i "testsrc2=size=320x240:rate=24,noise=alls=100:allf=t+u:all_seed=42"
    -f lavfi -i "sine=frequency=440:sample_rate=48000" -t 4
    -c:v libx264 -preset ultrafast -qp 0 -c:a aac -movflags +faststart "${DESTINATION}/front.mp4")
foreach(name tail.mp4 video.mkv video.mov video.avi)
    encode(-i "${DESTINATION}/front.mp4" -c copy "${DESTINATION}/${name}")
endforeach()
encode(-i "${DESTINATION}/front.mp4" -c copy -f mp4 "${DESTINATION}/video.m4v")
encode(-i "${DESTINATION}/front.mp4" -c copy -bsf:v h264_mp4toannexb -f mpegts "${DESTINATION}/video.ts")
encode(-i "${DESTINATION}/front.mp4" -c:v libvpx-vp9 -lossless 1 -deadline realtime
    -cpu-used 8 -threads 2 -c:a libopus "${DESTINATION}/video.webm")
